{
  "name": "UXU-Ilhan",
  "version": "1.0.0",
  "description": "Personal copy-paste component library (React + Vanilla) with a Next.js playground",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm check:css && pnpm check:docs && pnpm typecheck && next build",
    "start": "next start",
    "new": "node scripts/new-component.ts",
    "check:css": "node scripts/check-tailwind.ts",
    "check:docs": "node scripts/check-docs.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.18"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.10.1",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "figlet": "^1.12.0",
    "lucide-react": "^1.76.0",
    "next": "^16.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  }
}
